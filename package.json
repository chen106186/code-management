{
  "name": "code-management",
  "version": "0.1.0",
  "description": "Code Management Tool",
  "type": "module",
  "author": "chenng",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "web:dev": "vite",
    "web:build": "vite build",

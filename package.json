    "autoprefixer": "^10.6.2",
    "dompurify": "^3.4.15",
    "lucide-vue-next": "^0.577.0",
    "marked": "^14.0.0",
    "monaco-editor": "^0.57.0",
    "pinia": "^3.0.4",
    "postcss": "^8.5.32",
    "simple-icons": "^16.36.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.2.7",
    "vue": "^3.5.44",
    "vue-router": "^4.6.4",
    "vue-tsc": "^2.2.12"
  }
